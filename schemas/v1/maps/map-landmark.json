{
	"$id": "https://data.landsofhope.com/schemas/v1/maps/map-landmark.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/maps/map-landmark"
		},
		"allegiance": {
			"$ref": "/schemas/v1/allegiances-id.gen.json"
		},
		"desc": {
			"maxLength": 300,
			"minLength": 1,
			"type": "string"
		},
		"id": {
			"$ref": "/schemas/v1/maps/map-landmark-id.json"
		},
		"image": {
			"$ref": "/schemas/v1/maps-buildings-images-id.gen.json"
		},
		"level": {
			"additionalProperties": false,
			"properties": {
				"max": {
					"maximum": 1000,
					"minimum": 1,
					"type": "integer"
				},
				"min": {
					"maximum": 1000,
					"minimum": 1,
					"type": "integer"
				}
			},
			"type": "object"
		},
		"location": {
			"$ref": "/schemas/v1/coordinate2.json"
		},
		"name": {
			"maxLength": 40,
			"minLength": 1,
			"type": "string"
		},
		"owner": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "/schemas/v1/characters/character-id.json"
				}
			]
		},
		"type": {
			"$ref": "/schemas/v1/maps-landmarks-types-id.gen.json"
		},
		"world": {
			"$ref": "/schemas/v1/maps-worlds-id.gen.json"
		}
	},
	"required": [
		"$type",
		"id",
		"name",
		"desc",
		"world",
		"location",
		"image",
		"type",
		"owner",
		"allegiance"
	],
	"title": "MapLandmark",
	"type": "object"
}
