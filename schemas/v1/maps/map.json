{
    "$id": "https://data.landsofhope.com/schemas/v1/maps/map.json",
    "title": "Map",
    "type": "object",
    "properties": {
        "$type": {
            "const": "/v1/maps/map"
        },
        "id": {
            "$ref": "/schemas/v1/maps-worlds-id.gen.json"
        },
        "entry": {
            "$ref": "/schemas/v1/coordinate.json"
        },
        "extents": {
            "type": "object",
            "properties": {
                "topLeft": {
                    "$ref": "/schemas/v1/coordinate.json"
                },
                "bottomRight": {
                    "$ref": "/schemas/v1/coordinate.json"
                }
            },
            "required": [
                "topLeft",
                "bottomRight"
            ]
        }
    },
    "additionalProperties": false,
    "required": [
        "$type",
        "id",
        "entry",
        "extents"
    ]
}