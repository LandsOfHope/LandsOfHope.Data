{
	"$id": "https://data.landsofhope.com/schemas/v1/chat/chat-message.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/chat/chat-message"
		},
		"id": {
			"$ref": "/schemas/v1/chat/chat-message-id.json"
		},
		"parts": {
			"items": {
				"oneOf": [
					{
						"not": {
							"properties": {
								"$type": {
									"enum": ["/v1/chat/chat-mention", "/v1/links/link"]
								}
							},
							"required": ["$type"]
						},
						"properties": {
							"raw": {
								"type": "string"
							}
						},
						"required": ["raw"],
						"type": "object"
					},
					{
						"$ref": "/schemas/v1/chat/chat-mention.json"
					},
					{
						"$ref": "/schemas/v1/links/link.json"
					}
				]
			},
			"type": "array"
		},
		"raw": {
			"type": "string"
		},
		"sender": {
			"$ref": "/schemas/v1/chat/chat-participant.json"
		},
		"sent": {
			"$ref": "/schemas/v0/datetime.json"
		},
		"type": {
			"enum": ["message", "emote"]
		}
	},
	"required": ["$type", "id", "sender", "sent", "raw", "parts", "type"],
	"title": "ChatMessage",
	"type": "object"
}
