{
	"$id": "https://data.landsofhope.com/schemas/v1/items/location.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/items/location"
		},
		"image": {
			"type": "string"
		},
		"slot": {
			"additionalProperties": false,
			"properties": {
				"pet": {
					"type": "boolean"
				},
				"player": {
					"type": "boolean"
				},
				"pos": {
					"additionalProperties": false,
					"properties": {
						"x": {
							"type": "integer"
						},
						"y": {
							"type": "integer"
						}
					},
					"required": ["x", "y"],
					"type": "object"
				}
			},
			"required": ["player", "pet", "pos"],
			"type": "object"
		}
	},
	"required": ["$type"],
	"title": "ItemLocation",
	"type": "object"
}
