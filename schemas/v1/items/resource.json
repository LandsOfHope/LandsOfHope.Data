{
	"$id": "https://data.landsofhope.com/schemas/v1/items/resource.json",
	"title": "Resource",
	"type": "object",
	"properties": {
		"$type": {
			"const": "/v1/items/resource"
		},
		"id": {
			"$ref": "/schemas/v1/items-resources-id.gen.json"
		},
		"skill": {
			"$ref": "/schemas/v1/skills-id.gen.json"
		},
		"tools": {
			"type": "array",
			"items": {
				"$ref": "/schemas/v1/items-id.gen.json"
			},
			"minItems": 1
		},
		"items": {
			"type": "array",
			"items": {
				"$ref": "/schemas/v1/items-id.gen.json"
			},
			"minItems": 1
		},
		"bonuses": {
			"type": "object",
			"propertyNames": {
				"$ref": "/schemas/v1/items-id.gen.json"
			},
			"patternProperties": {
				".*": {
					"$ref": "/schemas/v1/random-chance.json"
				}
			},
			"additionalProperties": false
		},
		"material": {
			"$ref": "/schemas/v1/items-materials-id.gen.json"
		},
		"image": {
			"$ref": "/schemas/v1/items-images-id.gen.json"
		}
	},
	"additionalProperties": false,
	"required": ["$type", "id", "skill", "tools", "items", "material", "image"]
}
