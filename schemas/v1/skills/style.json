{
	"$id": "https://data.landsofhope.com/schemas/v1/skills/style.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/skills/style"
		},
		"effects": {
			"additionalProperties": false,
			"properties": {
				"damage": {
					"type": "integer"
				}
			},
			"required": ["damage"],
			"type": "object"
		},
		"id": {
			"type": "string"
		},
		"requirements": {
			"additionalProperties": false,
			"properties": {
				"level": {
					"minimum": 1,
					"type": "integer"
				},
				"skill": {
					"minimum": 1,
					"type": "integer"
				},
				"stamina": {
					"minimum": 0,
					"type": "integer"
				}
			},
			"required": ["stamina"],
			"type": "object"
		},
		"target": {
			"additionalProperties": false,
			"properties": {
				"mode": {
					"$ref": "/schemas/v1/skills/spell-target-mode.json"
				}
			},
			"required": ["mode"],
			"type": "object"
		}
	},
	"required": ["$type", "id", "requirements", "effects"],
	"title": "SkillsStyle",
	"type": "object"
}
