{
	"$id": "https://data.landsofhope.com/schemas/v1/skills/spell.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/skills/spell"
		},
		"duration": {
			"oneOf": [
				{
					"$ref": "/schemas/v0/duration.json"
				},
				{
					"minimum": 1,
					"type": "integer"
				}
			]
		},
		"effects": {
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"damage": {
					"type": "integer"
				},
				"dead": {
					"type": "integer"
				},
				"heal": {
					"type": "integer"
				},
				"heldcurrency": {
					"type": "integer"
				},
				"posess": {
					"additionalProperties": false,
					"oneOf": [
						{
							"properties": {
								"class": {
									"type": "string"
								}
							},
							"required": ["class"]
						},
						{
							"properties": {
								"race": {
									"$ref": "/schemas/v1/races-id.gen.json"
								}
							},
							"required": ["race"]
						},
						{
							"additionalProperties": false,
							"properties": {}
						}
					],
					"properties": {
						"class": {
							"type": "string"
						},
						"profession": {
							"$ref": "/schemas/v1/professions-id.gen.json"
						},
						"race": {
							"$ref": "/schemas/v1/races-id.gen.json"
						}
					},
					"type": "object"
				},
				"properties": {
					"additionalProperties": false,
					"patternProperties": {
						".*": {
							"type": "integer"
						}
					},
					"propertyNames": {
						"$ref": "/schemas/v1/characters/character-property-name.json"
					},
					"type": "object"
				},
				"queuebonus": {
					"type": "integer"
				},
				"raceid2": {
					"type": "integer"
				},
				"skills": {
					"additionalProperties": false,
					"patternProperties": {
						".*": {
							"type": "integer"
						}
					},
					"propertyNames": {
						"$ref": "/schemas/v1/skills-id.gen.json"
					},
					"type": "object"
				},
				"summon-item": {
					"additionalProperties": false,
					"properties": {
						"item": {
							"$ref": "/schemas/v1/items-id.gen.json"
						}
					},
					"required": ["item"],
					"type": "object"
				},
				"summon-pet": {
					"additionalProperties": false,
					"oneOf": [
						{
							"properties": {
								"class": {
									"type": "string"
								}
							},
							"required": ["class"]
						},
						{
							"properties": {
								"race": {
									"$ref": "/schemas/v1/races-id.gen.json"
								}
							},
							"required": ["race"]
						}
					],
					"properties": {
						"class": {
							"type": "string"
						},
						"profession": {
							"$ref": "/schemas/v1/professions-id.gen.json"
						},
						"race": {
							"$ref": "/schemas/v1/races-id.gen.json"
						}
					},
					"type": "object"
				}
			},
			"type": "object"
		},
		"id": {
			"type": "string"
		},
		"requirements": {
			"additionalProperties": false,
			"properties": {
				"level": {
					"minimum": 1,
					"type": "integer"
				},
				"mana": {
					"minimum": 1,
					"type": "integer"
				},
				"skill": {
					"minimum": 1,
					"type": "integer"
				}
			},
			"required": ["mana"],
			"type": "object"
		}
	},
	"required": ["$type", "id", "requirements", "effects"],
	"title": "SkillsSpell",
	"type": "object"
}
