{
	"$id": "https://data.landsofhope.com/schemas/v1/skills/crafting/recipe.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/skills/crafting/recipe"
		},
		"failureChance": {
			"$ref": "/schemas/v1/random-chance.json"
		},
		"id": {
			"$ref": "/schemas/v1/skills-crafting-recipes-id.gen.json"
		},
		"image": {
			"$ref": "/schemas/v1/items-images-id.gen.json"
		},
		"ingredients": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"id": {
						"$ref": "/schemas/v1/items-id.gen.json"
					},
					"primary": {
						"const": true
					},
					"quantity": {
						"minimum": 0,
						"type": "integer"
					}
				},
				"required": ["id", "quantity"],
				"type": "object"
			},
			"type": "array"
		},
		"makes": {
			"$ref": "/schemas/v1/skills/crafting/recipe-product.json"
		},
		"quality": {
			"$ref": "/schemas/v1/items/item-quality.json"
		},
		"quantity": {
			"minimum": 1,
			"type": "integer"
		},
		"singleUse": {
			"const": true
		},
		"skill": {
			"$ref": "/schemas/v1/skills-id.gen.json"
		},
		"skillValue": {
			"minimum": 1,
			"type": "integer"
		},
		"time": {
			"$ref": "/schemas/v0/duration.json"
		}
	},
	"required": [
		"$type",
		"id",
		"image",
		"makes",
		"time",
		"quantity",
		"skill",
		"skillValue",
		"quality",
		"ingredients"
	],
	"title": "SkillsCraftingRecipe",
	"type": "object"
}
