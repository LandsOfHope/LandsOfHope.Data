{
	"$id": "https://data.landsofhope.com/schemas/v1/accounts/keycloak/keycloak-user.json",
	"additionalProperties": true,
	"properties": {
		"access": {
			"additionalProperties": true,
			"properties": {
				"impersonate": {
					"type": "boolean"
				},
				"manage": {
					"type": "boolean"
				},
				"manageGroupMembership": {
					"type": "boolean"
				},
				"mapRoles": {
					"type": "boolean"
				},
				"view": {
					"type": "boolean"
				}
			},
			"type": "object"
		},
		"attributes": {
			"additionalProperties": true,
			"properties": {
				"birthdate": {
					"items": {
						"$ref": "/schemas/v0/date.json"
					},
					"maxItems": 1,
					"type": "array"
				},
				"returning_player_id": {
					"items": {
						"$ref": "/schemas/v1/accounts/returning/returning-account-token.json"
					},
					"maxItems": 1,
					"type": "array"
				}
			},
			"type": "object"
		},
		"createdTimestamp": {
			"type": "integer"
		},
		"disableableCredentialTypes": {
			"items": {
				"type": "string"
			},
			"type": "array"
		},
		"email": {
			"$ref": "/schemas/v1/email-address.json"
		},
		"emailVerified": {
			"type": "boolean"
		},
		"enabled": {
			"type": "boolean"
		},
		"id": {
			"$ref": "/schemas/v1/accounts/keycloak/keycloak-account-id.json"
		},
		"notBefore": {
			"type": "integer"
		},
		"requiredActions": {
			"items": {
				"$ref": "/schemas/v1/accounts/keycloak/keycloak-required-action.json"
			},
			"type": "array"
		},
		"totp": {
			"type": "boolean"
		},
		"username": {
			"type": "string"
		}
	},
	"required": [
		"id",
		"username",
		"email",
		"emailVerified",
		"createdTimestamp",
		"requiredActions",
		"attributes"
	],
	"title": "KeycloakUser",
	"type": "object"
}
