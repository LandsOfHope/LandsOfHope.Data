{
	"$id": "https://data.landsofhope.com/schemas/v1/accounts/cognito/cognito-access-token.json",
	"additionalProperties": true,
	"properties": {
		"auth_time": {
			"type": "number"
		},
		"client_id": {
			"type": "string"
		},
		"cognito:groups": {
			"items": {
				"$ref": "/schemas/v1/accounts/account-group.json"
			},
			"type": "array"
		},
		"exp": {
			"type": "number"
		},
		"iat": {
			"type": "number"
		},
		"iss": {
			"format": "uri",
			"type": "string"
		},
		"sub": {
			"$ref": "/schemas/v1/accounts/cognito/cognito-account-id.json"
		},
		"token_use": {
			"const": "access"
		},
		"username": {
			"type": "string"
		}
	},
	"required": [
		"sub",
		"iss",
		"client_id",
		"token_use",
		"auth_time",
		"exp",
		"iat",
		"username"
	],
	"title": "CognitoAccessToken",
	"type": "object"
}
