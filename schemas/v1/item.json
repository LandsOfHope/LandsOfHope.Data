{
	"$id": "https://data.landsofhope.com/schemas/v1/item.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/item"
		},
		"adjustable": {
			"const": true
		},
		"armorType": {
			"$ref": "/schemas/v1/items/armor-type.json"
		},
		"dpr": {
			"minimum": 0,
			"type": "integer"
		},
		"expansion": {
			"$ref": "/schemas/v1/expansions-id.gen.json"
		},
		"id": {
			"$ref": "/schemas/v1/items-id.gen.json"
		},
		"image": {
			"$ref": "/schemas/v1/items-images-id.gen.json"
		},
		"legendary": {
			"const": true
		},
		"material": {
			"$ref": "/schemas/v1/items-materials-id.gen.json"
		},
		"properties": {
			"additionalProperties": false,
			"minProperties": 1,
			"patternProperties": {
				".*": {
					"exclusiveMinimum": 0,
					"multipleOf": 0.01,
					"type": "number"
				}
			},
			"propertyNames": {
				"$ref": "/schemas/v1/characters/character-property-name.json"
			},
			"type": "object"
		},
		"set": {
			"$ref": "/schemas/v1/items-sets-id.gen.json"
		},
		"skill": {
			"$ref": "/schemas/v1/skills-id.gen.json"
		},
		"skills": {
			"additionalProperties": false,
			"minProperties": 1,
			"patternProperties": {
				".*": {
					"exclusiveMinimum": 0,
					"multipleOf": 0.01,
					"type": "number"
				}
			},
			"propertyNames": {
				"$ref": "/schemas/v1/skills-id.gen.json"
			},
			"type": "object"
		},
		"stackLimit": {
			"minimum": 1,
			"type": "integer"
		},
		"type": {
			"$ref": "/schemas/v1/items-types-id.gen.json"
		}
	},
	"required": ["$type", "image", "type"],
	"title": "Item",
	"type": "object"
}
