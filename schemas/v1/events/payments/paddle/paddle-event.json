{
	"$id": "https://data.landsofhope.com/schemas/v1/events/payments/paddle/paddle-event.json",
	"additionalProperties": true,
	"allOf": [
		{
			"properties": {
				"event_id": {
					"type": "string"
				},
				"occurred_at": {
					"$ref": "/schemas/v0/datetime.json"
				}
			},
			"required": ["event_id", "occurred_at"]
		},
		{
			"oneOf": [
				{
					"properties": {
						"data": {
							"$ref": "/schemas/v1/events/payments/paddle/paddle-subscription.json"
						},
						"event_type": {
							"enum": [
								"subscription.activated",
								"subscription.trialing",
								"subscription.canceled",
								"subscription.paused",
								"subscription.resumed"
							]
						}
					},
					"required": ["event_type", "data"]
				},
				{
					"properties": {
						"data": {
							"$ref": "/schemas/v1/events/payments/paddle/paddle-transaction.json"
						},
						"event_type": {
							"enum": ["transaction.completed"]
						}
					},
					"required": ["event_type", "data"]
				}
			]
		}
	],
	"required": ["event_id", "occurred_at", "event_type", "data"],
	"title": "PaddleEvent",
	"type": "object"
}
