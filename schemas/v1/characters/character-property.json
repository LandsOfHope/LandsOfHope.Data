{
	"$id": "https://data.landsofhope.com/schemas/v1/characters/character-property.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/characters/character-property"
		},
		"bonus": {
			"additionalProperties": false,
			"properties": {
				"item": {
					"type": "number"
				},
				"modifier": {
					"type": "number"
				},
				"spell": {
					"type": "number"
				}
			},
			"required": ["item", "spell", "modifier"],
			"type": "object"
		},
		"limit": {
			"oneOf": [
				{
					"exclusiveMinimum": 0,
					"type": "integer"
				},
				{
					"type": "null"
				}
			]
		},
		"natural": {
			"type": "integer"
		}
	},
	"required": ["$type", "natural", "bonus", "limit"],
	"title": "CharacterProperty",
	"type": "object"
}
