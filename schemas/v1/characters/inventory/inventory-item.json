{
	"$id": "https://data.landsofhope.com/schemas/v1/characters/inventory/inventory-item.json",
	"anyOf": [
		{
			"not": {
				"properties": {
					"enhancements": {
						"items": {
							"enum": [
								"imbued",
								"imprinted",
								"bejewelled",
								"named",
								"patched",
								"guilded"
							]
						},
						"minItems": 1,
						"type": "array"
					}
				},
				"required": ["enhancements"]
			}
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-imbued.json"
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-imprinted.json"
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-bejewelled.json"
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-named.json"
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-patched.json"
		},
		{
			"$ref": "/schemas/v1/characters/inventory/enhancements/enhanced-guilded.json"
		}
	],
	"properties": {
		"$type": {
			"const": "/v1/characters/inventory/inventory-item"
		},
		"actions": {
			"$ref": "/schemas/v1/characters/inventory/actions/inventory-item-actions.json"
		},
		"card": {
			"$ref": "/schemas/v1/items/card.json"
		},
		"enhancements": {
			"items": {
				"enum": [
					"imbued",
					"imprinted",
					"bejewelled",
					"named",
					"patched",
					"guilded"
				]
			},
			"minItems": 1,
			"type": "array"
		},
		"expiry": {
			"$ref": "/schemas/v0/datetime.json"
		},
		"guild": {
			"minimum": 1,
			"type": "integer"
		},
		"id": {
			"$ref": "/schemas/v1/characters/inventory/inventory-item-id.json"
		},
		"item": {
			"oneOf": [
				{
					"$ref": "/schemas/v1/item.json"
				},
				{
					"$ref": "/schemas/v1/items-id.gen.json"
				},
				{
					"$ref": "/schemas/v1/characters/inventory/unidentified-item.json"
				}
			]
		},
		"level": {
			"minimum": 0,
			"type": "integer"
		},
		"location": {
			"$ref": "/schemas/v1/characters/inventory/inventory-item-location.json"
		},
		"locked": {
			"additionalProperties": false,
			"properties": {
				"lockpicking": {
					"minimum": 5,
					"type": "integer"
				}
			},
			"required": ["lockpicking"],
			"type": "object"
		},
		"nickname": {
			"$ref": "/schemas/v1/characters/inventory/inventory-item-nickname.json"
		},
		"quality": {
			"minimum": 0,
			"type": "integer"
		},
		"quantity": {
			"$ref": "/schemas/v1/characters/inventory/inventory-item-quantity.json"
		},
		"stackHash": {
			"$ref": "/schemas/v1/characters/inventory/inventory-item-stack-hash.json"
		}
	},
	"required": [
		"$type",
		"id",
		"item",
		"level",
		"quantity",
		"location",
		"actions"
	],
	"title": "CharacterInventoryItem",
	"type": "object"
}
