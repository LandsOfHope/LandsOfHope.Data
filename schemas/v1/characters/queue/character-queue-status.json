{
	"$id": "https://data.landsofhope.com/schemas/v1/characters/queue/character-queue-status.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/characters/queue/character-queue-status"
		},
		"bonus": {
			"additionalProperties": false,
			"properties": {
				"items": {
					"maximum": 100,
					"minimum": 0,
					"type": "integer"
				},
				"size": {
					"maximum": 100,
					"minimum": 0,
					"type": "integer"
				},
				"time": {
					"$ref": "/schemas/v0/duration.json"
				}
			},
			"required": ["items", "size", "time"],
			"title": "CharacterQueueBonus",
			"type": "object"
		},
		"capacity": {
			"additionalProperties": false,
			"properties": {
				"current": {
					"maximum": 120,
					"minimum": 0,
					"type": "integer"
				},
				"max": {
					"maximum": 120,
					"minimum": 0,
					"type": "integer"
				}
			},
			"required": ["current", "max"],
			"title": "CharacterQueueCapacity",
			"type": "object"
		},
		"finished": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "/schemas/v0/datetime.json"
				}
			]
		}
	},
	"required": ["$type", "bonus", "capacity", "finished"],
	"title": "CharacterQueueStatus",
	"type": "object"
}
