{
	"$id": "https://data.landsofhope.com/schemas/v1/skill.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/skill"
		},
		"group": {
			"$ref": "/schemas/v1/skill-group.json"
		},
		"titles": {
			"additionalProperties": false,
			"patternProperties": {
				"^[0-9]+$": {
					"$ref": "/schemas/v1/titles-id.gen.json"
				}
			},
			"type": "object"
		}
	},
	"required": ["$type", "group"],
	"title": "Skill",
	"type": "object"
}
