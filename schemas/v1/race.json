{
	"$id": "https://data.landsofhope.com/schemas/v1/race.json",
	"additionalProperties": false,
	"properties": {
		"$type": {
			"const": "/v1/race"
		},
		"care": {
			"items": {
				"$ref": "/schemas/v1/skills-caring-actions-id.gen.json"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"classification": {
			"$ref": "/schemas/v1/races-classifications-id.gen.json"
		},
		"id": {
			"$ref": "/schemas/v1/races-id.gen.json"
		},
		"lootMaterial": {
			"$ref": "/schemas/v1/items-materials-id.gen.json"
		},
		"pics": {
			"$ref": "/schemas/v1/races/images.json"
		},
		"properties": {
			"additionalProperties": false,
			"minProperties": 1,
			"patternProperties": {
				".*": {
					"type": "integer"
				}
			},
			"propertyNames": {
				"$ref": "/schemas/v1/characters/character-property-name.json"
			},
			"type": "object"
		},
		"randomMaterial": {
			"$ref": "/schemas/v1/items-materials-id.gen.json"
		},
		"skills": {
			"additionalProperties": false,
			"minProperties": 1,
			"patternProperties": {
				".*": {
					"type": "integer"
				}
			},
			"propertyNames": {
				"$ref": "/schemas/v1/skills-id.gen.json"
			},
			"type": "object"
		}
	},
	"required": ["$type", "classification", "id", "pics"],
	"title": "Race",
	"type": "object"
}
